{
  "name": "storefront-guard-mcp-server",
  "version": "0.3.2",
  "mcpName": "io.github.maxigirl123/storefront-guard",
  "description": "Agent-side merchant verification: checks whether a storefront a shopping agent is about to pay looks like the same legitimate entity it was recently, before the agent commits payment.",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxigirl123/Fortik.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "storefront-guard-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:all": "node dist/server.js",
    "start:http": "cross-env TRANSPORT=http node dist/index.js",
    "start:x402": "node dist/x402Server.js",
    "start:rest": "node dist/restServer.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.19.2",
    "stripe": "^22.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4"
  }
}
